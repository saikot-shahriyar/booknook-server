# Server Environment Variables

# Port the Express server listens on.
# Default when unset: process.env.PORT || 5000 (src/server.js).
PORT=5000

# Base URL of the BookNook client app — used as the CORS origin.
CLIENT_URL=http://localhost:3000

# MongoDB Connection URI
# Required — database name is "booknook"
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/booknook

# Better Auth JWT Verification
# URL of the JWKS endpoint that exposes the public keys used to verify token
# signatures. Optional — defaults to http://localhost:3000/api/auth/jwks when unset.
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Expected value of the JWT `iss` claim when verifying tokens.
# Optional — defaults to http://localhost:3000 when unset.
BETTER_AUTH_ISSUER=http://localhost:3000

# Expected value of the JWT `aud` claim when verifying tokens.
# Optional — defaults to http://localhost:3000 when unset.
BETTER_AUTH_AUDIENCE=http://localhost:3000
